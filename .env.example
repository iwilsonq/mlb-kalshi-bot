# ─── Kalshi API credentials ──────────────────────────────────────────────
# Get your API key ID from https://kalshi.com/account/api
KALSHI_API_KEY_ID=your-api-key-id-here

# Path to your PEM-encoded private key file
# Generate at: https://kalshi.com/account/api
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/private-key.pem

# ─── Trading settings ───────────────────────────────────────────────────
# Use Kalshi demo environment (true/false)
USE_DEMO=true

# Dry-run mode — log signals without placing real orders (true/false)
DRY_RUN=true

# Max position size per trade in USD
MAX_POSITION_USD=5

# Kelly fraction for position sizing (0.0-1.0)
KELLY_FRACTION=0.25

# Max fraction of bankroll risked per calendar day (0 disables)
MAX_BANKROLL_FRACTION_PER_DAY=0.20

# Global floor on *cost-adjusted* edge (cents). The exact Kalshi fee at the
# contract's price and half the observed spread are subtracted per contract;
# EDGE_COST_BUFFER_CENTS is a residual adverse-selection haircut on top.
MIN_EDGE_CENTS=5

# Haircut applied to model−market edge before trade/size (spread + fees + AS)
EDGE_COST_BUFFER_CENTS=2

# Max contracts per order
MAX_CONTRACTS_PER_TRADE=10

# Circuit breaker: stop after this many consecutive losses
CIRCUIT_BREAKER_MAX_CONSECUTIVE_LOSSES=3

# Circuit breaker: stop after this much total loss in USD
CIRCUIT_BREAKER_MAX_LOSS_USD=10

# ─── Market selection ───────────────────────────────────────────────────
# Must be a subset of STRATEGY_PIPELINE in slugger/strategies.py; anything
# else listed here is inert. Retired implementations were deleted — see
# RETIRED_STRATEGIES for why each one died.
ENABLED_STRATEGIES=pitcher_ks,player_hits

# Optional external consensus fair prices JSON: {"TICKER": {"fair_cents": 42}}
# CONSENSUS_PRICES_PATH=

# Minimum market liquidity in USD to consider
MIN_LIQUIDITY_DOLLARS=5

# Cap correlated same-game exposure (signal count)
MAX_SIGNALS_PER_GAME=5

# Dollar exposure cap per game (0 = signal-count only). Default ≈ 2× max position.
MAX_EXPOSURE_PER_GAME_USD=10

# Rolling strategy auto-disable (journal settlements)
STRATEGY_HEALTH_WINDOW=50
STRATEGY_HEALTH_MIN_TRADES=30
STRATEGY_HEALTH_MIN_ROI_PCT=-25
# Max avg (model_brier - market_brier); disable if model worse by more than this
STRATEGY_HEALTH_MAX_BRIER_DEFICIT=0.02

# ─── Timing ─────────────────────────────────────────────────────────────
# Hours before game to start scanning
PREGAME_HOURS=2

# Seconds between market scans
POLL_INTERVAL_SEC=60

# ─── Data ───────────────────────────────────────────────────────────────
# Lookback window for stats in days
STATCAST_LOOKBACK_DAYS=30

# Minimum plate appearances for stats to be meaningful
MIN_SAMPLE_SIZE=20

# ─── Telegram (optional) ────────────────────────────────────────────────
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# ─── Odds API (the-odds-api.com) ────────────────────────────────────────
# Free tier: 500 credits/month. Player props cost [markets] x [regions] per
# event, so a full MLB slate snapshot (4 markets, us region, ~15 games) is ~60.
ODDS_API_KEY=
